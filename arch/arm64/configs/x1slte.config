# Exynos 990 Galaxy S20 LTE target.
CONFIG_MODEL_X1SLTE=y
CONFIG_EXYNOS_EL2=y
CONFIG_PINCTRL_SAMSUNG=y
CONFIG_CMDLINE="stack_depot_disable=on kasan.stacktrace=off kvm-arm.mode=protected cgroup_disable=pressure ignore_loglevel log_buf_len=2M pd_ignore_unused x1slte_boot_panic=45 printk.devkmsg=on"
# CONFIG_TRACE_MMIO_ACCESS is not set
CONFIG_USB_DWC3_EXYNOS_MODULE=y
# CONFIG_CP_PMUCAL is not set
# CONFIG_GNSS_PMUCAL is not set
# CONFIG_CHUB_PMUCAL is not set
# CONFIG_SCHED_EMS is not set
# CONFIG_EXYNOS_ARM64_COMMON_CLK is not set
# CONFIG_EXYNOS_ITMON_V2 is not set
# CONFIG_SND_SOC_SAMSUNG_ABOX is not set
# CONFIG_SND_SOC_SAMSUNG_VTS is not set

# CONFIG_SND_SOC_SAMSUNG_EXYNOS8835_AUDIO is not set
