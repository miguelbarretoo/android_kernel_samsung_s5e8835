diff --git a/kernel/selinux/rules.c b/kernel/selinux/rules.c
index c1d9d47b..7b8608f6 100644
--- a/kernel/selinux/rules.c
+++ b/kernel/selinux/rules.c
@@ -25,8 +25,10 @@
 #include "compat/kernel_compat.h"
 
 #if LINUX_VERSION_CODE >= KERNEL_VERSION(5, 10, 0)
+#ifndef SELINUX_POLICY_INSTEAD_SELINUX_SS
 #define SELINUX_POLICY_INSTEAD_SELINUX_SS
 #endif
+#endif
 
 #define ALL NULL
 
@@ -58,7 +60,12 @@ extern int avc_ss_reset(struct selinux_avc *avc, u32 seqno);
 // reset avc cache table, otherwise the new rules will not take effect if already denied
 static void reset_avc_cache()
 {
+	#ifdef SELINUX_POLICY_INSTEAD_SELINUX_SS
+	struct selinux_policy *policy = rcu_dereference(selinux_state.policy);
+	u32 seqno = policy ? ++policy->latest_granting : 1;
+	#else
 	u32 seqno = selinux_state.ss ? ++selinux_state.ss->latest_granting : 1;
+	#endif
 
 #if ((!defined(KSU_COMPAT_USE_SELINUX_STATE)) || \
 	LINUX_VERSION_CODE >= KERNEL_VERSION(6, 4, 0))
